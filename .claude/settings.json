{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/update-status-reminder.js\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
